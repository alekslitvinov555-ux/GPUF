{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gpuf",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*"
    ]
  },
  "containers": [
    {
      "class_name": "AtlasContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ATLAS_API",
        "class_name": "AtlasContainer"
      }
    ]
  },
  "exports": {
    "AtlasContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
